# Writes firmware_version.h with the git commit the firmware is built from
# (#154), and when it was built. Run as a script on every build (cmake -P), not at configure time, so
# each new commit stamps the next image without a reconfigure.
#
# Inputs: SOURCE_DIR (the repo), OUTPUT (the header to write).
# The version is the short commit hash, with "+" when the tree has
# uncommitted changes; tags are ignored so the text stays short enough for
# the panel's Status page.

execute_process(
    COMMAND git describe --always --dirty=+ --abbrev=7 --exclude=*
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE version
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET)
if(NOT result EQUAL 0 OR version STREQUAL "")
    set(version "unknown")
endif()

# The build time, local and to the minute, for the Home page footer: "6 Dec
# 09:41". The commit alone does not tell two builds of one dirty tree apart.
string(TIMESTAMP built "%d %b %H:%M")
string(REGEX REPLACE "^0" "" built "${built}")

set(content "#pragma once\n\n/// @brief Git commit this firmware was built from; \"+\" means uncommitted\n/// changes. Generated by tools/firmware_version.cmake on every build.\ninline constexpr char kFirmwareVersion[] = \"${version}\";\n\n/// @brief When this firmware was built, local time.\ninline constexpr char kFirmwareBuilt[] = \"${built}\";\n")

# Rewrite only on a change, so a build in the same minute does not rebuild
# the files that include it (ota_manager.cpp and mqtt_manager.cpp).
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
else()
    set(existing "")
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
