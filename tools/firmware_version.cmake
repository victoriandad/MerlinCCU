# Writes firmware_version.h with the git commit the firmware is built from
# (#154). Run as a script on every build (cmake -P), not at configure time, so
# each new commit stamps the next image without a reconfigure.
#
# Inputs: SOURCE_DIR (the repo), OUTPUT (the header to write).
# The version is the short commit hash, with "+" when the tree has
# uncommitted changes; tags are ignored so the text stays short enough for
# the panel's Status page.

execute_process(
    COMMAND git describe --always --dirty=+ --abbrev=7 --exclude=*
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE version
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET)
if(NOT result EQUAL 0 OR version STREQUAL "")
    set(version "unknown")
endif()

set(content "#pragma once\n\n/// @brief Git commit this firmware was built from; \"+\" means uncommitted\n/// changes. Generated by tools/firmware_version.cmake on every build.\ninline constexpr char kFirmwareVersion[] = \"${version}\";\n")

# Rewrite only on a change, so an unchanged commit does not rebuild the
# files that include it.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
else()
    set(existing "")
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
